{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "NodeNext", "moduleResolution": "NodeNext", "outDir": "dist-server",
    "rootDir": "src", "strict": true, "skipLibCheck": true, "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["node"]
  },
  "include": ["src/server", "src/shared"]
}
